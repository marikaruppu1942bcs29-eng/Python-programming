def prime(n):
    for i in range(2,int(n/2)+1):
        if n%i==0:
            return False
    return True
def sum1(n):
    for i in range(2,n):
        if prime(i) and prime(n-i):
            print(n,"=",i,"+",(n-i))
            return
    print("cannot be expressed as sum of two prime no")
n=int(input("enter a number:"))
sum1(n)
