a=[]
b=[]
r1=int(input("enter rows of matrix a:"))
c1=int(input("enter column of matrix a:"))
r2=int(input("enter rows of matrix b:"))
c2=int(input("enter column of matrix b:"))
if c1!=r2:
   print("matrix multiplication not possible")
else:
   print("enter elements of matrix a")
   for i in range(r1):
       row=[]
       for j in range(c1):
         row.append(int(input()))
       a.append(row)
   print("enter elements of matrix b")
   for i in range(r2):
       row=[]
       for j in range(c2):
         row.append(int(input()))
       b.append(row)
   result=[[0 for j in range(c2)]for i in range(r1)]
for i in range(r1):
   for j in range(c2):
      for k in range(c1):
          result[i][j]+=a[i][k]*b[k][j]
print("result matrix")
for row in result:
   print(row)
