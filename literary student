class Student:
    def __init__(self):
        self.name = ""
        self.roll_no = 0
        self.test_mark = 0

    def get_student(self):
        self.name = input("Enter Name: ")
        self.roll_no = int(input("Enter Roll No: "))
        self.test_mark = float(input("Enter Test Marks: "))

    def total_marks(self):
        return self.test_mark

    def display(self):
        print("\n--- Student Details ---")
        print("Name:", self.name)
        print("Roll No:", self.roll_no)
        print("Test Marks:", self.test_mark)


class Literary_Student(Student):
    def __init__(self):
        super().__init__()
        self.literary_marks = 0

    def get_data(self):
        self.get_student()
        self.literary_marks = float(input("Enter Literary Marks: "))

    def total_marks(self):
        return self.test_mark + self.literary_marks

    def display(self):
        print("\n--- Literary Student ---")
        print("Name:", self.name)
        print("Roll No:", self.roll_no)
        print("Test Marks:", self.test_mark)
        print("Literary Marks:", self.literary_marks)
        print("Total Marks:", self.total_marks())


