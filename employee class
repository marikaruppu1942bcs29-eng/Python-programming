class employee:
   def __init__ (self,basic):
      self.basic=basic
   def calculate_salary(self):
      da=0.10*self.basic
      hra=0.2*self.basic
      gross=self.basic+da+hra
      print("basic salary:",self.basic)
      print("da(10%):",da)
      print("hra(20%):",hra)
      print("gross salary:",gross)
basic=float(input("enter basic salary:"))
emp=employee(basic)
emp.calculate_salary()
