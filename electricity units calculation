units=int(input("enter electricity units:"))
if units<=100:
   amount=0
elif units<=200:
   amount=(units-100)*1.5
elif units<=300:
   amount=(100*1.5)+(units-200)*2.5
elif units<=400:
   amount=(100*1.5)+(100*2.5)+(units-300)*4
else:
   amount=(100*1.5)+(100*2.5)+(100*4)+(units-400)*5
print("electricity bill=rupees:",amount)
